{
  "manifest_version": 3,
  "name": "OttO: Organizer of Tabs, Too Overpowered",
  "short_name": "OttO",
  "version": "0.1.0",
  "description": "Groups the tabs in your window by topic with an LLM you choose, and suggests duplicate tabs to close.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": ["https://api.anthropic.com/*", "https://api.openai.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "OttO",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "organize-window": {
      "suggested_key": { "default": "Alt+Shift+O" },
      "description": "Organize the tabs in this window"
    }
  }
}
